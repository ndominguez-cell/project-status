# Public canonical origin used to create absolute social-preview URLs.
# Local example: http://localhost:3000
# Hosted example: https://your-private-site.example
PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 GitHub App placeholders. Never expose the private key to the browser.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
